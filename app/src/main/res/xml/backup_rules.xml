<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-backup rules (Android 12 and below).
    Referenced from AndroidManifest.xml via android:fullBackupContent.
-->
<full-backup-content>
    <!-- Don't back up Vosk model cache (large, re-downloadable) -->
    <exclude domain="file" path="model" />
    <!-- SharedPreferences are safe to back up (contains wake word setting) -->
    <include domain="sharedpref" path="hypeai.xml" />
</full-backup-content>
