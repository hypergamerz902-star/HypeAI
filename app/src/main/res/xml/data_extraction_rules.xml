<?xml version="1.0" encoding="utf-8"?>
<!--
    Data-extraction rules (Android 12+, API 31+).
    Referenced from AndroidManifest.xml via android:dataExtractionRules.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Don't send Vosk model to cloud (large, re-downloadable) -->
        <exclude domain="file" path="model" />
        <include domain="sharedpref" path="hypeai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="model" />
        <include domain="sharedpref" path="hypeai.xml" />
    </device-transfer>
</data-extraction-rules>
